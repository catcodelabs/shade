{
  "custom/shade-menu": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Right-click for more shade options",
    "menu": "on-click-right",
    "menu-file": "${SHADE_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/shade-menu.xml",
    "menu-actions": {
      "animations-select": "shade-shell animations --select",
      "wallpaper-select": "shade-shell app -t scope -- wallpaper.sh --select --global",
      "wallpaper-next": "shade-shell app -t scope -- wallpaper.sh --next --global",
      "wallpaper-previous": "shade-shell app -t scope -- wallpaper.sh --previous --global",
      "wallpaper-random": "shade-shell app -t scope -- wallpaper.sh --random --global",
      "theme-next": "shade-shell app -t scope -- theme.switch.sh -n",
      "theme-previous": "shade-shell app -t scope -- theme.switch.sh -p",
      "theme-select": "shade-shell app -t scope -- theme.select.sh",
      "theme-import": "shade-shell app -T -- shadectl theme import",
      "layouts-select": "shade-shell layouts --select;pkill -RTMIN+19 waybar",
      "waybar-restart": "shade-shell waybar -ubg",
      "waybar-reload-css": "sed -i '${/^$/d;}'  $XDG_CONFIG_HOME/waybar/style.css",
      "waybar-layout-select": "shade-shell waybar --select-layout",
      "waybar-style-select": "shade-shell waybar --select-style",
      "waybar-layout-next": "shade-shell waybar --update --next",
      "waybar-layout-previous": "shade-shell waybar --update --prev",
      "lockscreen-select": "shade-shell lockscreen --select",
      "workflows-select": "shade-shell workflows --select;pkill -RTMIN+19 waybar",
      "hyprsunset-toggle": "shade-shell hyprsunset -t -P waybar:19",
      "temp-off": "shade-shell hyprsunset --cm temp -s identity -P waybar:19 ",
      "warm-candle": "shade-shell hyprsunset --cm temp -s 3000 -P waybar:19",
      "soft-warm": "shade-shell hyprsunset --cm temp -s 4000 -P waybar:19",
      "neutral-white": "shade-shell hyprsunset --cm temp -s 5000 -P waybar:19",
      "daylight": "shade-shell hyprsunset --cm temp -s 6500 -P waybar:19",
      "cool-white": "shade-shell hyprsunset --cm temp -s 7500 -P waybar:19",
      "bright-blue": "shade-shell hyprsunset --cm temp -s 9000 -P waybar:19",
      "arctic-blue": "shade-shell hyprsunset --cm temp -s 10000 -P waybar:19",
      "gamma-100": "shade-shell hyprsunset --cm gamma -s 100 -P waybar:19",
      "gamma-90": "shade-shell hyprsunset --cm gamma -s 90 -P waybar:19",
      "gamma-80": "shade-shell hyprsunset --cm gamma -s 80 -P waybar:19",
      "gamma-70": "shade-shell hyprsunset --cm gamma -s 70 -P waybar:19",
      "gamma-60": "shade-shell hyprsunset --cm gamma -s 60 -P waybar:19",
      "gamma-50": "shade-shell hyprsunset --cm gamma -s 50 -P waybar:19",
      "gamma-40": "shade-shell hyprsunset --cm gamma -s 40 -P waybar:19",
      "gamma-30": "shade-shell hyprsunset --cm gamma -s 30 -P waybar:19",
      "gamma-20": "shade-shell hyprsunset --cm gamma -s 20 -P waybar:19",
      "shaders-select": "shade-shell shaders --select;pkill -RTMIN+19 waybar",
      "keybinds-hint": "shade-shell keybinds_hint",
      "about-shade": "xdg-open https://shadeproject.pages.dev"
    }
  }
}
