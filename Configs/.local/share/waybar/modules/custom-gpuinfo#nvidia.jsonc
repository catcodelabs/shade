{
  "custom/gpuinfo#nvidia": {
    "exec-if": "shade-shell  gpuinfo.sh --stat nvidia >/dev/null 2>&1",
    "exec": "shade-shell app -t scope gpuinfo.sh --use nvidia ",
    "return-type": "json",
    "format": "{0}",
    "rotate": 0,
    "interval": 5,
    "tooltip": true,
    "max-length": 1000
  }
}
