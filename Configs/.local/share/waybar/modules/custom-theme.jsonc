{
    "custom/theme": {
        "format": "{0}",
        "rotate": 0,
        "tooltip-format": "\udb81\udfe1 Switch theme",
        "on-click": "shade-shell app -t scope -- theme.switch.sh -n",
        "on-click-right": "shade-shell app -t scope -- theme.switch.sh -p",
        "on-click-middle": "sleep 0.1 && shade-shell app -t scope -- theme.select.sh",
        "interval": 86400,
        "tooltip": true
    }
}
