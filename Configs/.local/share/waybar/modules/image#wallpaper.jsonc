{
    "image#wallpaper": {
	"exec": "realpath $XDG_CACHE_HOME/shade/wall.set; echo -e \"◉ Right-click: Select theme | ◈ Left-click: Select wallpaper\"",
    "on-click" : "shade-shell app -t scope -- wallpaper.sh --select --global;pkill -RTMIN+19 waybar",
    "on-click-right" : "shade-shell app -t scope -- theme.select.sh;pkill -RTMIN+19 waybar",
    "tooltip" : true,
    "signal": 19
}
}