#!/usr/bin/env sh

[ -n "${SHADE_ACTIVATED:-}" ] && return 0 2>/dev/null

SHADE_ACTIVATED=1

SHADE_MODE=""
HYPRLAND_CONFIG=""

# A per-user runtime directory. Falling back to a shared directory would put
# sockets from every session into one namespace, so the fallback is private and
# only readable by its owner.
shade_runtime_dir() {
    _uid=$(id -u 2>/dev/null) || _uid=''

    if [ -n "$_uid" ] && [ -d "/run/user/$_uid" ] && [ -w "/run/user/$_uid" ]; then
        printf '%s\n' "/run/user/$_uid"
        unset _uid
        return 0
    fi

    _dir="${TMPDIR:-/tmp}/shade-${_uid:-$$}"
    mkdir -p "$_dir" 2>/dev/null && chmod 700 "$_dir" 2>/dev/null
    printf '%s\n' "$_dir"
    unset _uid _dir
}

setup_xdg() {
    : "${XDG_CONFIG_HOME:=$HOME/.config}"
    : "${XDG_CACHE_HOME:=$HOME/.cache}"
    : "${XDG_DATA_HOME:=$HOME/.local/share}"
    : "${XDG_STATE_HOME:=$HOME/.local/state}"

    # fallback only
    [ -n "${XDG_RUNTIME_DIR:-}" ] || XDG_RUNTIME_DIR=$(shade_runtime_dir)

    export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_RUNTIME_DIR
}

shade_die() {
    printf '%s\n' "$*" >&2
    return 1
}

shade_has() {
    command -v "$1" >/dev/null 2>&1
}

find_shade_lua() {
    for path in \
        "$XDG_DATA_HOME/hypr/shade.lua" \
        /usr/local/share/hypr/shade.lua \
        /usr/share/hypr/shade.lua; do
        [ -f "$path" ] && {
            printf '%s\n' "$path"
            return 0
        }
    done

    return 1
}

find_hyprland_bin() {
    for bin in \
        Hyprland \
        hyprland; do
        if shade_has "$bin"; then
            command -v "$bin"
            return 0
        fi
    done

    return 1
}

hyprland_has_lua() {
    shade_has readelf || return 0

    _hyprbin=$(find_hyprland_bin) || return 1

    case "$(readelf -d "$_hyprbin" 2>/dev/null)" in
    *NEEDED*lua*)
        return 0
        ;;
    esac

    return 1
}

# Mirrors the resolution order in pyutils/lua_env.py, so a runtime that is good
# enough to provision the environment is not rejected here.
shade_find_bin() {
    for _candidate in "$@"; do
        [ -n "$_candidate" ] || continue
        if command -v "$_candidate" >/dev/null 2>&1; then
            printf '%s\n' "$_candidate"
            unset _candidate
            return 0
        fi
    done

    unset _candidate
    return 1
}

shade_find_lua() {
    shade_find_bin "${LUA:-}" lua lua5.5 lua5.4 lua5.3
}

shade_find_luarocks() {
    shade_find_bin "${LUAROCKS:-}" luarocks luarocks-5.5 luarocks-5.4 luarocks-5.3
}

check_lua_runtime() {
    _missing=''
    shade_find_lua >/dev/null || _missing='lua'
    shade_find_luarocks >/dev/null || _missing="${_missing:+$_missing }luarocks"

    [ -z "$_missing" ] || {
        printf 'Lua runtime incomplete, missing: %s\n' "$_missing" >&2
        unset _missing
        return 1
    }

    unset _missing
    return 0
}

setup_lua_mode() {
    HYPRLAND_CONFIG=$(find_shade_lua)

    check_lua_runtime || return 1

    hyprland_has_lua || {
        printf 'Hyprland lacks Lua support\n' >&2
        return 1
    }

    SHADE_MODE="lua"
    SHADE_FEATURE_LUA=1

    export SHADE_FEATURE_LUA

    return 0
}

setup_session() {
    : "${XDG_CURRENT_DESKTOP:=shade}"
    : "${XDG_SESSION_DESKTOP:=shade}"
    : "${XDG_SESSION_TYPE:=wayland}"

    export XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
}

shade_activate() {
    setup_xdg
    setup_session

    if setup_lua_mode; then
        :
    else
        shade_die 'No valid shade configuration found'
        return 1
    fi

    export SHADE_ACTIVATED SHADE_MODE HYPRLAND_CONFIG

    return 0
}

shade_activate
